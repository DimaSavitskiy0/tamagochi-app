{
  "expo": {
    "name": "ЛапGo",
    "slug": "lapgo-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lapgoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lapgoapp.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Нужен доступ к фото, чтобы вы могли выбрать аватар для своего питомца."
      }
    },
    "android": {
      "package": "com.lapgoapp.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#7c4dff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7c4dff"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "./plugins/withRuStorePay",
        {
          "consoleAppId": "2063745190"
        }
      ],
      [
        "./plugins/withRuStorePush",
        {
          "projectId": "RevOcN0b1gQBZcOJsBSbkS3VQ5YANtdh"
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
