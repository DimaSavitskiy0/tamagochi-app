# URL of your own backend (see server/) — must be hosted in Russia for 152-ФЗ
# compliance. Leave empty/unset to run fully offline on mock data (no real accounts,
# no network calls) — every hook falls back to that automatically.
EXPO_PUBLIC_API_URL=https://api.your-domain.ru

# ЮKassa (YooKassa) secrets and S3 storage credentials do NOT belong here — anything
# prefixed EXPO_PUBLIC_ ships inside the client app bundle. They live on the server
# instead: see server/.env.example and server/README.md.
