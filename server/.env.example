# Локально: docker compose up -d, затем DATABASE_URL как ниже.
# На Timeweb Cloud: строка подключения из панели Managed PostgreSQL.
DATABASE_URL=postgresql://lapgo:lapgo@localhost:5432/lapgo?schema=public

PORT=3000

# Сгенерировать: openssl rand -hex 32 (свой отдельный секрет для каждого)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# RuStore Pay — ключ (AES-256, base64) из RuStore Console → приложение → Монетизация →
# Серверные уведомления, выдаётся один раз при подключении URL вебхука (см. server/README.md).
# Не обязателен: без него POST /payments/rustore-webhook отвечает 503, остальной API работает.
RUSTORE_WEBHOOK_SECRET=

# RuStore Push — из RuStore Console → приложение → Push-уведомления → Проекты.
# Не обязательны: без них POST /auth/send-test-push отвечает 503, остальной API работает
# (клиент всё равно сохраняет push-токен через PATCH /auth/push-token — просто пока
# некуда/нечем его использовать).
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_AUTH_TOKEN=

# RuStore Public API — для кнопки «Отменить подписку» в приложении. Ключ из RuStore
# Console → API RuStore → Создать ключ, область доступа: приложение ЛапGo, методы —
# только "Получение данных подписки" и "Отмена подписки" (принцип минимальных прав).
# ВАЖНО: это не готовый bearer-токен — это приватный ключ (RSA), которым сервер сам
# подписывает и обменивает на короткоживущий (15 мин) JWE перед каждым запросом
# (см. src/lib/rustoreApiAuth.ts). Значение из консоли — то, что показано в
# всплывающем окне при генерации ключа (длинный блок, начинается как приватный ключ).
RUSTORE_API_TOKEN=
# "ID ключа" — колонка рядом с ключом в списке "API RuStore" (не секрет, просто id).
RUSTORE_API_KEY_ID=
# Не секрет — тот же id, что в app.json → plugins → withRuStorePay → consoleAppId.
RUSTORE_APP_ID=2063745190

# Ключ Anthropic API — для персонального ИИ-совета на главном экране (console.anthropic.com).
# Не обязателен: без него роут /pets/:id/ai-tip просто отвечает 503, остальной API работает.
ANTHROPIC_API_KEY=

# Домен мобильного приложения / Expo dev — можно оставить "*" пока нет прод-домена
CORS_ORIGIN=*

# SMTP — для отправки кода восстановления пароля (POST /auth/forgot-password).
# Не обязателен: без него код всё равно генерируется и работает, но письмо не уходит —
# в dev-режиме код вместо этого печатается в консоль сервера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ЛапGo <no-reply@lapgo.ru>
